    {
      "name": "GET public snippets",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/snippets/public",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "snippets",
            "public"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const body = pm.response.json();",
              "pm.test('Response is an array', function () {",
              "  pm.expect(Array.isArray(body)).to.eql(true);",
              "});",
              "pm.test('All snippets are public', function () {",
              "  body.forEach(function (item) {",
              "    pm.expect(item.is_private).to.eql(false);",
              "  });",
              "});"
            ]
          }
        }
      ]
