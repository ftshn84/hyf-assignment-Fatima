{
  "info": {
    "_postman_id": "4b81f5f1-2f85-46bd-9d71-7a8b69931c9f",
    "name": "HYF Snippets API (Assignment)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET all snippets",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/snippets",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "snippets"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const body = pm.response.json();",
              "pm.test('Response is an array', function () {",
              "  pm.expect(Array.isArray(body)).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "POST create snippet",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user_id\": 1,\n  \"title\": \"Postman created snippet\",\n  \"contents\": \"Created from Postman collection\",\n  \"is_private\": false,\n  \"tags\": [1]\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/snippets",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "snippets"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "const body = pm.response.json();",
              "pm.test('Created snippet has id', function () {",
              "  pm.expect(body).to.have.property('id');",
              "});"
            ]
          }
        }
      ]
    },
